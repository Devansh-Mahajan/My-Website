---
import FormattedDate from './FormattedDate.astro';
import { getUrl } from '../utils/url';

interface Props {
	title: string;
	description?: string;
	date?: Date;
	slug: string;
}

const { title, description, date, slug } = Astro.props;
---

<a class="post-row" href={getUrl(`/${slug}/`)}>
	{date && (
		<time class="post-date"><FormattedDate date={date} /></time>
	)}
	<span class="post-main">
		<h3 class="post-title">{title}</h3>
		{description && <p class="post-desc">{description}</p>}
	</span>
	<span class="post-arrow" aria-hidden="true">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
	</span>
</a>

<style>
	.post-row {
		display: grid;
		grid-template-columns: 8rem 1fr auto;
		gap: 1.5rem;
		align-items: baseline;
		padding: 1.5rem 0;
		border-top: 1px solid rgba(var(--gray), 0.16);
		color: rgb(var(--black));
		text-decoration: none;
		transition: opacity 0.15s ease;
	}
	.post-row:first-child { border-top: none; }

	.post-row:hover { opacity: 0.72; }

	.post-date {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.02em;
		color: rgb(var(--gray));
		padding-top: 0.3rem;
	}

	.post-title {
		margin: 0 0 0.4rem;
		font-size: 1.2rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.008em;
		color: rgb(var(--black));
	}

	.post-desc {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: rgb(var(--gray));
		max-width: 46ch;
	}

	.post-arrow {
		align-self: center;
		display: flex;
		color: rgb(var(--gray));
		transition: transform 0.15s ease, color 0.15s ease;
	}
	.post-row:hover .post-arrow { transform: translateX(3px); color: var(--accent); }

	@media (max-width: 640px) {
		.post-row { grid-template-columns: 1fr auto; }
		.post-date { display: none; }
	}
</style>
