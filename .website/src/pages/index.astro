---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCard from '../components/BlogCard.astro';
import { QUARTZ_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import { getUrl } from '../utils/url';

const notes = {
	home:        QUARTZ_URL,
	eecs:        `${QUARTZ_URL}200-ETH-Zurich/ETH-BSc-EECS---Overview`,
	math:        `${QUARTZ_URL}300-IMO-+-Putnam/Strategies-in-problem-solving`,
	programming: `${QUARTZ_URL}400-IOI/Competitive-Programming`,
	books:       `${QUARTZ_URL}500-Book/Book-Notes`,
	sidequests:  `${QUARTZ_URL}600-Sidequests/Sidequests`,
	quant:       `${QUARTZ_URL}700-Quant/Quantitative-Work`,
	projects:    `${QUARTZ_URL}800-Projects/Projects`,
};

const posts = (await getCollection('blog'))
	.filter((post) => post.data.publish)
	.sort((a, b) => {
		const dateA = a.data.created_date?.valueOf() ?? 0;
		const dateB = b.data.created_date?.valueOf() ?? 0;
		return dateB - dateA;
	})
	.slice(0, 3);

const hasPosts = posts.length > 0;

const selectedWork = [
	{
		title: 'ETH Zurich EECS Notebook',
		meta: 'Circuits · Signals · Systems',
		description: 'Coursework notes on digital circuits, signal processing, linear systems, and computer architecture.',
		href: notes.eecs,
	},
	{
		title: 'Competitive Programming',
		meta: 'Algorithms · Complexity',
		description: 'Problem-solving notes, algorithm templates, and contest technique at IOI difficulty.',
		href: notes.programming,
	},
	{
		title: 'Projects',
		meta: 'Hardware · Software · Quant',
		description: 'Build logs across hardware, software systems, and quantitative experiments.',
		href: notes.projects,
	},
];

const noteLinks = [
	{ label: 'ETH Zurich EECS',        href: notes.eecs },
	{ label: 'Problem Solving',         href: notes.math },
	{ label: 'Competitive Programming', href: notes.programming },
	{ label: 'Book Notes',              href: notes.books },
	{ label: 'Sidequests',              href: notes.sidequests },
	{ label: 'Quantitative Work',       href: notes.quant },
	{ label: 'Projects',                href: notes.projects },
];

const focusAreas = [
	{ title: 'Electronics',       description: 'Circuits, signals, digital logic, and physical systems.' },
	{ title: 'Mathematics',       description: 'Proofs, linear algebra, calculus, probability, and problem solving.' },
	{ title: 'Software Systems',  description: 'Implementation, automation, infrastructure, and data workflows.' },
	{ title: 'Quantitative Work', description: 'Modelling, backtesting, statistics, and computational experiments.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>

			<!-- ── HERO ─────────────────────────────────── -->
			<section class="hero" aria-labelledby="hero-name">
				<p class="eyebrow">ETH Z&uuml;rich &middot; EECS</p>
				<h1 id="hero-name">Devansh Mahajan</h1>
				<p class="tagline">Electrical engineering and mathematics.</p>
				<p class="lead">Coursework, problem sets, and side projects &mdash; written up as I go and kept public, not cleaned up after the fact.</p>

				<div class="hero-links">
					<a href={notes.home} target="_blank" rel="noreferrer">
						Browse Notes
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7m0 0H7m10 0v10"/></svg>
					</a>
					<a href="https://github.com/Devansh-Mahajan" target="_blank" rel="noreferrer">GitHub</a>
					<a href="https://www.linkedin.com/in/devansh-mahajan-2b2b99185/" target="_blank" rel="noreferrer">LinkedIn</a>
				</div>

				<p class="hero-meta" aria-label="Status">
					<span>BSc Candidate</span>
					<span>Spring 2026</span>
					<span>Z&uuml;rich</span>
				</p>
			</section>

			<!-- ── SELECTED WORK ──────────────────────────── -->
			<section class="section" aria-labelledby="work-heading">
				<p class="section-label" id="work-heading">Selected work</p>

				<div class="work-list">
					{selectedWork.map((item) => (
						<a class="work-row" href={item.href} target="_blank" rel="noreferrer">
							<span class="work-meta">{item.meta}</span>
							<span class="work-main">
								<h3>{item.title}</h3>
								<p>{item.description}</p>
							</span>
							<span class="work-arrow" aria-hidden="true">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
							</span>
						</a>
					))}
				</div>
			</section>

			<!-- ── BROWSE NOTES ──────────────────────────── -->
			<section class="section" aria-labelledby="notes-heading">
				<p class="section-label" id="notes-heading">Browse notes</p>
				<p class="notes-line">
					{noteLinks.map((link, i) => (
						<>
							{i > 0 && <span class="notes-sep">&middot;</span>}
							<a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
						</>
					))}
					<a class="all-notes" href={notes.home} target="_blank" rel="noreferrer">&rarr; All notes</a>
				</p>
			</section>

			<!-- ── FOCUS ─────────────────────────────────── -->
			<section class="section" aria-labelledby="focus-heading">
				<p class="section-label" id="focus-heading">Focus</p>
				<dl class="focus-list">
					{focusAreas.map((area) => (
						<div class="focus-item">
							<dt>{area.title}</dt>
							<dd>{area.description}</dd>
						</div>
					))}
				</dl>
			</section>

			<!-- ── WRITING ───────────────────────────────── -->
			{hasPosts && (
				<section class="section" aria-labelledby="writing-heading">
					<p class="section-label" id="writing-heading">Writing</p>
					<div class="posts-grid">
						{posts.map((post) => (
							<BlogCard
								title={post.data.title}
								description={post.data.description}
								date={post.data.created_date}
								slug={post.id}
							/>
						))}
					</div>
					<a class="more-link" href={getUrl('/blog')}>All writing &rarr;</a>
				</section>
			)}

		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 780px;
		margin: 0 auto;
		padding: 0 1.5rem 7rem;
	}

	/* ═══ HERO ═══ */
	.hero {
		padding: 4.75rem 0 4.25rem;
		opacity: 0;
		animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.05s forwards;
	}
	@keyframes rise {
		from { opacity: 0; transform: translateY(8px); }
		to   { opacity: 1; transform: translateY(0); }
	}
	@media (prefers-reduced-motion: reduce) {
		.hero { animation: none; opacity: 1; }
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		color: rgb(var(--gray));
		margin: 0 0 1.5rem;
	}

	.hero h1 {
		font-size: clamp(2.75rem, 7vw, 4rem);
		font-weight: 500;
		line-height: 1.02;
		margin-bottom: 0.6rem;
	}

	.tagline {
		font-family: var(--font-heading);
		font-style: italic;
		font-weight: 400;
		font-size: clamp(1.25rem, 2.6vw, 1.5rem);
		color: rgb(var(--gray));
		margin: 0 0 1.75rem;
	}

	.lead {
		max-width: 46ch;
		font-size: 1.0625rem;
		line-height: 1.7;
		color: rgb(var(--gray));
		margin: 0 0 2.25rem;
	}

	.hero-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 1.5rem;
		font-family: var(--font-ui);
		font-size: 0.9rem;
		margin-bottom: 2.25rem;
	}
	.hero-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: rgb(var(--black));
		border-bottom: 1px solid rgba(var(--gray), 0.4);
		padding-bottom: 1px;
	}
	.hero-links a:hover { color: var(--accent); border-color: var(--accent); }
	.hero-links a svg { opacity: 0.6; }

	.hero-meta {
		display: flex;
		gap: 0.5rem;
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.03em;
		color: rgb(var(--gray));
		opacity: 0.75;
	}
	.hero-meta span + span::before { content: '/'; margin-right: 0.5rem; opacity: 0.5; }

	/* ═══ SECTIONS ═══ */
	.section { padding: 3.75rem 0; border-top: 1px solid rgba(var(--gray), 0.16); }

	.section-label {
		font-family: var(--font-ui);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		margin: 0 0 2rem;
	}

	/* Selected work — editorial index rows */
	.work-list { display: flex; flex-direction: column; }
	.work-row {
		display: grid;
		grid-template-columns: 11rem 1fr auto;
		gap: 1.5rem;
		align-items: baseline;
		padding: 1.5rem 0;
		border-top: 1px solid rgba(var(--gray), 0.16);
		color: rgb(var(--black));
		text-decoration: none;
		transition: opacity 0.15s ease;
	}
	.work-list .work-row:first-child { border-top: none; }
	.work-row:hover { opacity: 0.72; }

	.work-meta {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.02em;
		color: rgb(var(--gray));
		padding-top: 0.3rem;
	}
	.work-main h3 {
		font-size: 1.2rem;
		font-weight: 500;
		margin: 0 0 0.4rem;
	}
	.work-main p {
		font-size: 0.9375rem;
		line-height: 1.6;
		color: rgb(var(--gray));
		margin: 0;
		max-width: 46ch;
	}
	.work-arrow {
		align-self: center;
		display: flex;
		color: rgb(var(--gray));
		transition: transform 0.15s ease, color 0.15s ease;
	}
	.work-row:hover .work-arrow { transform: translateX(3px); color: var(--accent); }

	/* Browse notes — inline index */
	.notes-line {
		font-family: var(--font-ui);
		font-size: 0.95rem;
		line-height: 2.1;
		color: rgb(var(--gray));
		margin: 0;
	}
	.notes-line a {
		color: rgb(var(--black));
		border-bottom: 1px solid rgba(var(--gray), 0.4);
	}
	.notes-line a:hover { color: var(--accent); border-color: var(--accent); }
	.notes-sep { color: rgb(var(--gray)); margin: 0 0.55rem; opacity: 0.6; }
	.notes-line .all-notes {
		font-size: 0.85rem;
		color: var(--accent);
		border: none;
		margin-left: 0.4rem;
	}

	/* Focus — definition list */
	.focus-list { display: flex; flex-direction: column; gap: 1.6rem; margin: 0; }
	.focus-item { display: grid; grid-template-columns: 12rem 1fr; gap: 1.5rem; }
	.focus-item dt { font-family: var(--font-heading); font-weight: 500; font-size: 1.05rem; }
	.focus-item dd {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.65;
		color: rgb(var(--gray));
		max-width: 46ch;
	}

	/* Writing */
	.more-link {
		display: inline-block;
		margin-top: 1rem;
		font-family: var(--font-ui);
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--accent);
	}

	/* ═══ RESPONSIVE ═══ */
	@media (max-width: 640px) {
		main { padding: 0 1.25rem 5rem; }
		.hero { padding: 3rem 0 2.5rem; }
		.section { padding: 2.75rem 0; }

		.work-row { grid-template-columns: 1fr auto; }
		.work-meta { display: none; }

		.focus-item { grid-template-columns: 1fr; gap: 0.35rem; }

		.hero-meta { flex-wrap: wrap; }
	}
</style>
