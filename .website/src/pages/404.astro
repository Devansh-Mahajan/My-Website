---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, QUARTZ_URL } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`404 — ${SITE_TITLE}`}
			description="This page doesn't exist."
			no_index={true}
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="shell">
				<p class="code">404</p>
				<h1>Page not found.</h1>
				<p class="sub">The destination doesn't exist. Navigate back or browse the notes.</p>
				<div class="actions">
					<a href="/" class="link-primary">Home &rarr;</a>
					<a href={QUARTZ_URL} target="_blank" rel="noreferrer" class="link-ghost">Notes</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		min-height: calc(100vh - 12rem);
		display: flex;
		align-items: center;
	}

	.shell {
		max-width: 520px;
	}

	.code {
		margin: 0 0 1.25rem;
		font-family: var(--font-ui);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		color: rgb(var(--gray));
		text-transform: uppercase;
	}

	h1 {
		margin: 0 0 1rem;
		font-weight: 500;
		font-size: clamp(2.5rem, 6vw, 3.5rem);
		line-height: 1.05;
		letter-spacing: -0.015em;
	}

	.sub {
		margin: 0 0 2rem;
		max-width: 46ch;
		font-size: 1.0625rem;
		line-height: 1.7;
		color: rgb(var(--gray));
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		font-family: var(--font-ui);
		font-size: 0.9rem;
		font-weight: 500;
	}

	.link-primary { color: var(--accent); }

	.link-ghost {
		color: rgb(var(--black));
		border-bottom: 1px solid rgba(var(--gray), 0.4);
	}
	.link-ghost:hover { color: var(--accent); border-color: var(--accent); }
</style>
