# ── Admin credentials ───────────────────────────────────────────────────────
# Generate with: npm run setup
ADMIN_PASSWORD_HASH=

# Your email address (receives password reset emails)
ADMIN_EMAIL=mahajandevansh@gmail.com

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=

# ── GitHub ───────────────────────────────────────────────────────────────────
# Fine-grained PAT with "Contents" read+write on My-Website repo
GITHUB_PAT=
GITHUB_REPO_OWNER=Devansh-Mahajan
GITHUB_REPO_NAME=My-Website

# ── Resend (email) ───────────────────────────────────────────────────────────
# Create a free account at resend.com
RESEND_API_KEY=

# ── App URL (no trailing slash) ──────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
